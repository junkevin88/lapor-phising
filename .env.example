# === Salin file ini menjadi `.env.local` di folder yang sama dengan package.json ===
# File `.env.local` TIDAK boleh di-commit (sudah di-ignore di .gitignore).

# --- Kunci API (salah satu) ---
# Pakai OpenAI resmi:
OPENAI_API_KEY=sk-ganti-dengan-key-asli-kamu
# Atau kunci khusus penyedia lain (Groq, OpenRouter, …) — kalau diisi, ini dipakai menggantikan OPENAI_API_KEY:
# LLM_API_KEY=gsk_atau_sk_or_key_lain

# --- Host API kompatibel OpenAI (opsional) ---
# Default mengarah ke https://api.openai.com/v1. Jika OpenAI diblokir di jaringanmu, pakai penyedia lain yang punya endpoint kompatibel, misalnya:
#
# Groq (chat + teks; cek dokumentasi model untuk dukungan gambar/vision):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (banyak model; set header situs agar sesuai kebijakan mereka):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# OPENAI_MODEL=openai/gpt-4o-mini
# OPENROUTER_REFERER=https://localhost:3000
# OPENROUTER_TITLE=TANYA AI

# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model & opsional OpenAI ---
# Model chat analisis (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Model transkrip audio (default: gpt-4o-mini-transcribe) — hanya jika endpoint penyedia mendukung API transkrip OpenAI
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Kode bahasa audio ISO-639-1 (default: id = Indonesia). Ubah ke "en" jika rekaman bahasa Inggris.
# OPENAI_TRANSCRIBE_LANGUAGE=id

# Prompt bantu (opsional) — harus selaras dengan bahasa di OPENAI_TRANSCRIBE_LANGUAGE
# OPENAI_TRANSCRIBE_PROMPT=Percakapan bahasa Indonesia tentang perbankan dan pesan mencurigakan.

# OPENAI_ORG_ID=org_...
# OPENAI_PROJECT_ID=proj_...
