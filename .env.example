# === Salin file ini menjadi `.env.local` di folder yang sama dengan package.json ===
# File `.env.local` TIDAK boleh di-commit (sudah di-ignore di .gitignore).

# --- Wajib ---
# API key dari https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-ganti-dengan-key-asli-kamu

# --- Opsional ---
# Model chat analisis (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Model transkrip audio tab Suara (default: gpt-4o-mini-transcribe)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Kode bahasa audio ISO-639-1 (default: id = Indonesia). Ubah ke "en" jika rekaman bahasa Inggris.
# OPENAI_TRANSCRIBE_LANGUAGE=id

# Prompt bantu (opsional) — harus selaras dengan bahasa di OPENAI_TRANSCRIBE_LANGUAGE
# OPENAI_TRANSCRIBE_PROMPT=Percakapan bahasa Indonesia tentang perbankan dan pesan mencurigakan.

# OPENAI_ORG_ID=org_...
# OPENAI_PROJECT_ID=proj_...
